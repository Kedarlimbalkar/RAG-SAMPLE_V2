# PostgreSQL & pgvector Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scrag_legal
POSTGRES_USER=scrag_user
POSTGRES_PASSWORD=scrag_password
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_POOL_TIMEOUT=30

# Embedding Model (Local Execution)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true

# Storage & Snapshots
DATA_DIR=./data
RAW_PDF_DIR=./data/raw_pdfs
PROCESSED_SNAPSHOT_DIR=./data/snapshots
EXPORT_FORMAT=parquet

# Google Cloud Infrastructure (V2 Storage)
GCP_PROJECT_ID=sc-legal-rag-prod
GCP_REGION=asia-south1
GCS_BUCKET_NAME=sc-legal-rag-data-v2
GCS_RAW_PREFIX=raw
GCS_PARSED_PREFIX=parsed-v2
GCS_CHUNKS_PREFIX=chunks-v2
GCS_SNAPSHOTS_PREFIX=snapshots-v2
WIF_PROVIDER=projects/123456789012/locations/global/workloadIdentityPools/github-pool/providers/github-provider
WIF_SERVICE_ACCOUNT=github-actions-sa@sc-legal-rag-prod.iam.gserviceaccount.com

# PDF Parser Tuning
PARSER_HEADER_BAND_RATIO=0.12
PARSER_FOOTER_BAND_RATIO=0.88
PARSER_HEADER_FOOTER_THRESHOLD=0.30
PARSER_FOOTNOTE_FONT_RATIO=0.85
PARSER_MIN_PAGE_CHARS=40
PARSER_MAX_GARBAGE_RATIO=0.25
OCR_ENABLED=true
TESSERACT_CMD=

# Hierarchical Chunking
CHUNK_PARENT_WORDS=1500
CHUNK_PARENT_OVERLAP=150
CHUNK_CHILD_WORDS=350
CHUNK_CHILD_OVERLAP=50

# Worker Queue & Pipeline
MAX_RETRIES=3
QUEUE_POLL_INTERVAL_SEC=2.0
WORKER_CONCURRENCY=4

